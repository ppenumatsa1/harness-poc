# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Foundry (BYOK). Auth uses your `az login`; no API key.
FOUNDRY_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
FOUNDRY_MODEL=gpt-5.4-mini

# Local Postgres passwords (any values; local only)
POSTGRES_PASSWORD=change-me
APP_RO_PASSWORD=change-me-ro
APP_RW_PASSWORD=change-me-rw

# Optional: App Insights connection string (telemetry is off when empty)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional: session AI-credit cap (Lesson 13). 0 = off. Minimum when on is 30.
MAX_AI_CREDITS=0
