# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# Foundry (BYOK). Auth uses your `az login`; no API key.
FOUNDRY_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
FOUNDRY_MODEL=gpt-5.4-mini

# Local Postgres passwords live in ./secrets (run ./make_secrets.sh), not here.
